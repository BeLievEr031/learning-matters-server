# ===========================================================================
# Environment Configuration for Learning Matters Server
# ===========================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ===========================================================================

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# Application environment (development | test | production)
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# Logging level (trace | debug | info | warn | error | fatal | silent)
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database – PostgreSQL
# ---------------------------------------------------------------------------

# Full connection URL: postgres://user:password@host:port/database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/learning_matters

# Maximum number of connections in the pool (default: 10)
DB_POOL_MAX=10

# How long (ms) a connection can sit idle before being closed (default: 10000)
DB_POOL_IDLE_MS=10000

# How long (ms) to wait for a new connection before timing out (default: 5000)
DB_POOL_CONN_TIMEOUT_MS=5000

# Maximum duration (ms) a statement can run before being cancelled (default: 30000)
DB_STATEMENT_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Cache – Redis
# ---------------------------------------------------------------------------

# Redis connection URL: redis://[:password@]host[:port][/db-index]
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Authentication – JSON Web Tokens
# ---------------------------------------------------------------------------

# Secret for signing access tokens. MUST be at least 32 random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Secret for signing refresh tokens. Use a DIFFERENT secret from the access token.
JWT_REFRESH_SECRET=change-me-to-another-random-string-32-chars-min

# Access token time-to-live (e.g. 15m, 1h)
JWT_ACCESS_TTL=15m

# Refresh token time-to-live (e.g. 7d, 30d)
JWT_REFRESH_TTL=7d

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Comma-separated list of allowed origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------

# Window size in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per window per IP (default: 100)
RATE_LIMIT_MAX=100

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Number of reverse proxy hops to trust for req.ip (0 = no proxy, 1 = one proxy)
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------

# Sentry DSN – leave empty to disable Sentry integration
SENTRY_DSN=

# Set to "true" to enable Swagger UI in production
ENABLE_DOCS=false

# Bearer token required to access GET /metrics (leave empty to restrict to localhost only)
METRICS_TOKEN=
